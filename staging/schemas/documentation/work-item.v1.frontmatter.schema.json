{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Work Item Frontmatter",
  "description": "Strict frontmatter schema for backlog work items supporting SDLC and Diataxis standards.",
  "additionalProperties": false,
  "allOf": [
    { "$ref": "doc.v1.frontmatter.schema.json" },
    {
      "type": "object",
      "required": ["priority"],
      "properties": {
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        }
      },
      "unevaluatedProperties": false
    }
  ]
}
