{
    "compilerOptions": {
        "target": "esnext",
        "lib": [
            "ESNext"
        ],
        "rootDir": ".",
        "outDir": "dist",
        "module": "esnext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "moduleResolution": "bundler"
    },
    "include": [
        "lib/**/*",
        "scripts/**/*",
        "cli/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}