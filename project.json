{
  "name": "doc-vader",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "root": ".",
  "sourceRoot": ".",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest"
      }
    },
    "docs-lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash staging/scripts/docs-lint.sh"
      }
    },
    "docs-lint-fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "markdownlint-cli2 --fix 'docs/**/*.md' '*.md'"
      }
    },
    "backlog-validate": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "pnpm -s run dv backlog validate --dir backlog --fail-on error"
      }
    },
    "backlog-validate-ci": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh staging/scripts/backlog-hygiene-ci.sh"
      }
    },
    "backlog-validate-ci-raw": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "pnpm -s run dv backlog validate --dir backlog --profile profiles/backlog-ci.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash staging/scripts/docs-lint.sh"
      }
    }
  }
}
