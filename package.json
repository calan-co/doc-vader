{
  "name": "@calan-co/doc-vader",
  "version": "0.0.1",
  "description": "Documentation automation, validation, and governance CLI for Markdown-based projects.",
  "main": "dist/lib/index.js",
  "files": [
    "dist/",
    "profiles/",
    "schemas/",
    "templates/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "nx build doc-vader",
    "changeset": "changeset",
    "clean": "nx reset && rm -rf node_modules dist",
    "typecheck": "tsc --noEmit",
    "test": "nx test doc-vader --watch=false",
    "dv": "node dist/cli/doc-vader.js",
    "prepare": "husky",
    "changeset:check": "node --import tsx scripts/validate-changesets.ts",
    "schemas:policy:check": "node --import tsx scripts/validate-schema-lifecycle.ts",
    "docs:lint": "nx run doc-vader:docs-lint",
    "docs:lint:fix": "nx run doc-vader:docs-lint-fix",
    "backlog:validate": "nx run doc-vader:backlog-validate",
    "backlog:validate:ci": "nx run doc-vader:backlog-validate-ci",
    "backlog:validate:ci:raw": "nx run doc-vader:backlog-validate-ci-raw",
    "hooks:commit-msg": "commitlint --edit",
    "hooks:pre-push": "pnpm run schemas:policy:check && pnpm run changeset:check && node --import tsx scripts/validate-work-items-pre-push.ts",
    "lint": "pnpm run schemas:policy:check && nx run doc-vader:lint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bin": {
    "doc-vader": "dist/cli/doc-vader.js",
    "dv": "dist/cli/doc-vader.js"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.2",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@wikimedia/jsonschema-tools": "^1.3.0",
    "husky": "^9.1.7",
    "memfs": "^4.57.6",
    "nx": "^22.7.5",
    "sury": "11.0.0-alpha.7",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@commander-js/extra-typings": "github:commander-js/extra-typings",
    "@segment/ajv-human-errors": "^2.16.0",
    "@sinclair/typebox": "^0.34.49",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "~15.0.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.2.0",
    "minimatch": "^10.2.5",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-lint": "^10.0.1",
    "remark-lint-frontmatter-schema": "^3.15.4",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "semver": "^7.8.3",
    "unified-lint-rule": "^3.0.1",
    "unist-util-position": "^5.0.0",
    "unist-util-visit-parents": "^6.0.2",
    "vfile": "^6.0.3",
    "zod": "^4.4.3"
  }
}
