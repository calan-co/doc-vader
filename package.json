{
  "name": "@calan-co/doc-vader",
  "version": "0.0.1",
  "description": "Documentation automation, validation, and governance CLI for Markdown-based projects.",
  "main": "dist/lib/index.js",
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "build": "nx build doc-vader",
    "changeset": "changeset",
    "test": "nx test doc-vader",
    "prepare": "husky",
    "docs:lint": "nx run doc-vader:docs-lint",
    "docs:lint:fix": "nx run doc-vader:docs-lint-fix",
    "backlog:validate": "nx run doc-vader:backlog-validate",
    "backlog:validate:ci": "nx run doc-vader:backlog-validate-ci",
    "backlog:validate:ci:raw": "nx run doc-vader:backlog-validate-ci-raw",
    "hooks:commit-msg": "commitlint --edit",
    "lint": "nx run doc-vader:lint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bin": {
    "doc-vader": "dist/cli/doc-vader.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@types/node": "^24.10.0",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.0.8",
    "@wikimedia/jsonschema-tools": "^1.3.0",
    "gray-matter": "^2.1.1",
    "husky": "^9.1.7",
    "memfs": "^4.50.0",
    "nx": "^20.4.6",
    "sury": "^11.0.0-alpha.4",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vitest": "^4.0.10"
  },
  "dependencies": {
    "@commander-js/extra-typings": "github:commander-js/extra-typings",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.2",
    "glob": "^11.0.3",
    "js-yaml": "^4.1.1",
    "minimatch": "^10.2.4",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-lint": "^10.0.1",
    "remark-lint-frontmatter-schema": "^3.15.3",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "semver": "^7.7.3",
    "unist-util-position": "^5.0.0",
    "vfile": "^6.0.3"
  }
}
