{
  "name": "doc-vader",
  "version": "0.0.1",
  "description": "This directory contains JSON schemas for validating various documentation types.",
  "main": "dist/lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npx vitest",
    "postinstall": "npx jsonschema-tools install-git-hook",
    "docs:lint": "sh staging/scripts/docs-lint.sh",
    "docs:lint:fix": "markdownlint-cli2 --fix 'docs/**/*.md' '*.md'",
    "backlog:validate": "node dist/cli/doc-vader.js backlog validate --dir backlog --fail-on error",
    "backlog:validate:ci": "sh staging/scripts/backlog-hygiene-ci.sh",
    "backlog:validate:ci:raw": "node dist/cli/doc-vader.js backlog validate --dir backlog --profile profiles/backlog-ci.json",
    "lint": ""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bin": {
    "doc-vader": "dist/cli/doc-vader.js"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.0.8",
    "@wikimedia/jsonschema-tools": "^1.3.0",
    "gray-matter": "^2.1.1",
    "memfs": "^4.50.0",
    "sury": "^11.0.0-alpha.4",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vitest": "^4.0.10"
  },
  "dependencies": {
    "@commander-js/extra-typings": "github:commander-js/extra-typings",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.2",
    "glob": "^11.0.3",
    "js-yaml": "^4.1.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-lint": "^10.0.1",
    "remark-lint-frontmatter-schema": "^3.15.3",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "semver": "^7.7.3",
    "unist-util-position": "^5.0.0"
  }
}
