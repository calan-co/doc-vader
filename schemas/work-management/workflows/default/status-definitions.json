{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "$id": "/work-management/workflows/default/status-definitions",
  "title": "work-management/workflows/default/status-definitions",
  "description": "Repository-default work-item status, reason, category, and connectivity definitions.",
  "$comment": "EDIT THIS FILE when adding or renaming repository-default workflow vocabulary. Keep transition-profile.json mappings aligned.",
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "running",
        "paused",
        "completed",
        "aborted"
      ]
    },
    "draftReason": {
      "type": "string",
      "enum": [
        "needs-triage",
        "awaiting-approval",
        "deferred",
        "blocked-by-dependency",
        "blocked",
        "needs-info"
      ]
    },
    "readyReason": {
      "type": "string",
      "enum": [
        "auto",
        "recoverable",
        "prioritized",
        "scheduled",
        "dependencies-cleared",
        "unblocked"
      ]
    },
    "runningReason": {
      "type": "string",
      "enum": [
        "implementation",
        "investigation",
        "verification",
        "review",
        "awaiting-feedback",
        "reverting-for-pr-workflow"
      ]
    },
    "pausedReason": {
      "type": "string",
      "enum": ["blocked", "policy", "system", "manual"]
    },
    "completedReason": {
      "type": "string",
      "enum": [
        "completed",
        "awaiting-review",
        "verification-pending",
        "implementation-complete"
      ]
    },
    "abortedReason": {
      "type": "string",
      "enum": ["rejected", "duplicate", "obsolete", "cancelled", "wontfix"]
    },
    "reasonCategory": {
      "type": "string",
      "enum": [
        "intake",
        "planning",
        "execution",
        "review",
        "completed",
        "decision"
      ]
    },
    "connectivityClass": {
      "type": "string",
      "enum": ["start", "intermediate", "end"]
    }
  }
}
