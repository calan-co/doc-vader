{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "$id": "/work-management/workflows/default/status-policy",
  "title": "work-management/workflows/default/status-policy",
  "description": "Repository-default lifecycle compatibility and status-dependent work-item constraints.",
  "$comment": "EDIT THIS FILE when changing repository-default lifecycle compatibility or status-conditioned work-item requirements. Status vocabulary belongs in status-definitions.schema.json.",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "id": {
            "pattern": "^wi-"
          }
        }
      },
      "then": true,
      "else": {
        "$ref": "/work-management/workflows/default/generated/status-reason-compatibility"
      }
    },
    {
      "anyOf": [
        {
          "required": ["id", "lifecycle", "status"],
          "properties": {
            "id": { "pattern": "^wi-" },
            "lifecycle": { "enum": ["draft", "active", "inactive"] },
            "status": { "enum": ["draft", "ready", "paused", "completed", "closed", "aborted"] }
          },
          "allOf": [
            { "if": { "properties": { "lifecycle": { "const": "draft" } } }, "then": { "properties": { "status": { "enum": ["draft", "closed"] } } } },
            { "if": { "properties": { "lifecycle": { "const": "active" } } }, "then": { "properties": { "status": { "enum": ["ready", "paused", "completed", "closed", "aborted"] } } } },
            { "if": { "properties": { "lifecycle": { "const": "inactive" } } }, "then": { "properties": { "status": { "const": "closed" } } } },
            { "if": { "properties": { "status": { "const": "aborted" } } }, "then": { "required": ["status_reason"], "properties": { "status_reason": { "const": "cancelled" } } } },
            { "if": { "properties": { "status": { "const": "closed" } } }, "then": { "required": ["status_reason"], "properties": { "status_reason": { "enum": ["completed", "obsolete", "superseded", "redundant", "cancelled"] } } } },
            { "if": { "properties": { "status": { "const": "completed" } } }, "then": { "required": ["status_reason"], "properties": { "status_reason": { "const": "completed" } } } },
            { "if": { "properties": { "status": { "const": "paused" } } }, "then": { "required": ["status_reason"], "properties": { "status_reason": { "const": "blocked" } } } }
          ]
        },
        {
          "type": "object",
          "properties": {
            "lifecycle": {
              "const": "draft"
            },
            "status": {
              "enum": ["draft", "aborted"]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "lifecycle": {
              "const": "active"
            },
            "status": {
              "enum": [
                "ready",
                "running",
                "paused",
                "completed",
                "aborted"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "lifecycle": {
              "const": "evergreen"
            },
            "status": {
              "enum": [
                "ready",
                "running",
                "paused",
                "completed",
                "aborted"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "lifecycle": {
              "const": "inactive"
            },
            "status": {
              "enum": ["completed", "aborted"]
            }
          }
        }
      ]
    },
    {
      "if": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "enum": ["completed", "aborted"]
          }
        }
      },
      "then": {
        "type": "object",
        "required": ["links"],
        "properties": {
          "links": {
            "$ref": "/work-management/support/common#/$defs/workItemLinks"
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["estimated"]
            },
            "then": {
              "required": ["actual"]
            }
          }
        ]
      }
    }
  ]
}
