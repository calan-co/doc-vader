{
  "$schema": "../../support/transition-profile.schema.json",
  "$id": "/work-management/workflows/default/transition-profile",
  "$comment": "EDIT THIS FILE when changing repository-default status-to-reason domains, derived mappings, or allowed transitions.",
  "version": "1.0.0",
  "sourceDimensions": {
    "status": {
      "path": "/status",
      "domain": "/work-management/workflows/default/status-definitions#/$defs/status"
    },
    "reason": {
      "path": "/status_reason",
      "allowUnknown": false,
      "domainBy": {
        "dimension": "status",
        "cases": {
          "draft": "/work-management/workflows/default/status-definitions#/$defs/draftReason",
          "ready": "/work-management/workflows/default/status-definitions#/$defs/readyReason",
          "running": "/work-management/workflows/default/status-definitions#/$defs/runningReason",
          "paused": "/work-management/workflows/default/status-definitions#/$defs/pausedReason",
          "completed": "/work-management/workflows/default/status-definitions#/$defs/completedReason",
          "aborted": "/work-management/workflows/default/status-definitions#/$defs/abortedReason"
        },
        "requiredCases": [
          "completed",
          "aborted"
        ]
      }
    }
  },
  "derivedDimensions": {
    "category": {
      "kind": "lookup",
      "from": [
        "status",
        "reason"
      ],
      "table": "statusReasonCategories"
    },
    "connectivity": {
      "kind": "lookup",
      "from": [
        "status",
        "reason"
      ],
      "table": "statusReasonConnectivities"
    }
  },
  "lookupTables": {
    "statusReasonCategories": {
      "values": "/work-management/workflows/default/status-definitions#/$defs/reasonCategory",
      "total": true,
      "map": {
        "draft": {
          "needs-triage": "intake",
          "awaiting-approval": "intake",
          "deferred": "intake",
          "blocked-by-dependency": "execution",
          "blocked": "execution",
          "needs-info": "intake"
        },
        "ready": {
          "auto": "planning",
          "recoverable": "planning",
          "prioritized": "planning",
          "scheduled": "planning",
          "dependencies-cleared": "planning",
          "unblocked": "planning"
        },
        "running": {
          "implementation": "execution",
          "investigation": "execution",
          "verification": "execution",
          "review": "review",
          "awaiting-feedback": "execution",
          "reverting-for-pr-workflow": "execution"
        },
        "paused": {
          "blocked": "execution",
          "policy": "execution",
          "system": "execution",
          "manual": "execution"
        },
        "completed": {
          "completed": "completed",
          "awaiting-review": "review",
          "verification-pending": "review",
          "implementation-complete": "review"
        },
        "aborted": {
          "rejected": "decision",
          "duplicate": "decision",
          "obsolete": "decision",
          "cancelled": "decision",
          "wontfix": "decision"
        }
      }
    },
    "statusReasonConnectivities": {
      "values": "/work-management/workflows/default/status-definitions#/$defs/connectivityClass",
      "default": "intermediate",
      "map": {
        "draft": {
          "needs-triage": "start",
          "awaiting-approval": "start",
          "needs-info": "start"
        },
        "completed": {
          "*": "end"
        },
        "aborted": {
          "*": "end"
        }
      }
    }
  },
  "transitions": {
    "precedence": [
      "reason",
      "category",
      "status"
    ],
    "rules": [
      {
        "id": "forward-draft-to-ready",
        "from": {
          "category": "intake"
        },
        "to": {
          "category": "planning"
        },
        "decision": "allow"
      },
      {
        "id": "forward-ready-to-running",
        "from": {
          "category": "planning"
        },
        "to": {
          "category": "execution"
        },
        "decision": "allow"
      },
      {
        "id": "forward-running-to-review",
        "from": {
          "category": "execution"
        },
        "to": {
          "category": "review"
        },
        "decision": "allow"
      },
      {
        "id": "forward-review-to-completed",
        "from": {
          "category": "review"
        },
        "to": {
          "category": "completed"
        },
        "decision": "allow"
      },
      {
        "id": "abort-from-any-nonterminal",
        "from": {
          "status": [
            "draft",
            "ready",
            "running",
            "paused"
          ]
        },
        "to": {
          "status": "aborted",
          "category": "decision"
        },
        "decision": "allow"
      },
      {
        "id": "completed-from-ready",
        "from": {
          "status": "ready",
          "category": "planning"
        },
        "to": {
          "status": "completed",
          "category": "completed"
        },
        "decision": "allow"
      },
      {
        "id": "completed-from-running",
        "from": {
          "status": [
            "running"
          ],
          "category": "execution"
        },
        "to": {
          "status": "completed",
          "category": "completed"
        },
        "decision": "allow"
      },
      {
        "id": "pause-running",
        "from": {
          "status": [
            "running"
          ],
          "category": "execution"
        },
        "to": {
          "status": "paused",
          "category": "execution"
        },
        "decision": "allow"
      },
      {
        "id": "resume-paused",
        "from": {
          "status": "paused",
          "category": "execution"
        },
        "to": {
          "status": "running",
          "category": "execution"
        },
        "decision": "allow"
      },
      {
        "id": "rollback-review-to-running",
        "from": {
          "status": [
            "completed"
          ],
          "category": "review"
        },
        "to": {
          "status": "running",
          "category": "execution"
        },
        "decision": "allow"
      },
      {
        "id": "rollback-running-to-ready",
        "from": {
          "status": [
            "running",
            "paused"
          ],
          "category": "execution"
        },
        "to": {
          "status": "ready",
          "category": "planning"
        },
        "decision": "allow"
      },
      {
        "id": "rollback-running-to-draft",
        "from": {
          "status": [
            "running",
            "paused"
          ],
          "category": "execution"
        },
        "to": {
          "status": "draft",
          "category": "intake"
        },
        "decision": "allow"
      },
      {
        "id": "rollback-ready-to-draft",
        "from": {
          "status": "ready",
          "category": "planning"
        },
        "to": {
          "status": "draft",
          "category": "intake"
        },
        "decision": "allow"
      },
      {
        "id": "rollback-review-to-draft-needs-info",
        "from": {
          "status": [
            "completed"
          ],
          "category": "review"
        },
        "to": {
          "status": "draft",
          "reason": "needs-info"
        },
        "decision": "allow"
      }
    ]
  }
}
