{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/work-management/direct-push-reconciliation.schema",
  "title": "Direct-push historical reconciliation policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled", "repository", "protected_ref", "from", "status", "reason", "receipt", "changed_files"],
  "properties": {
    "$schema": { "type": "string" },
    "enabled": { "const": true },
    "repository": { "type": "string", "pattern": "^github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "protected_ref": { "type": "string", "pattern": "^refs/heads/[A-Za-z0-9._/-]+$" },
    "from": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "status": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subtype", "outcome"],
      "properties": {
        "subtype": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 }
      }
    },
    "changed_files": { "const": "exact" }
  }
}
