{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/work-management/template-metadata",
  "title": "work-management/template-metadata",
  "description": "Template frontmatter contract for templjs-authored work-management templates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$content_schema"],
  "properties": {
    "type": {
      "$ref": "/work-management/support/common#/$defs/primaryType"
    },
    "$types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "/work-management/support/common#/$defs/primaryType"
      }
    },
    "subtype": {
      "$ref": "/work-management/support/common#/$defs/nonEmptyString"
    },
    "$subtypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "/work-management/support/common#/$defs/nonEmptyString"
      }
    },
    "$schema": {
      "$ref": "/work-management/support/common#/$defs/frontmatterSchemaRef"
    },
    "$content_schema": {
      "$ref": "/work-management/support/common#/$defs/contentSchemaRef"
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "required": ["type"],
          "not": {
            "required": ["$types"]
          }
        },
        {
          "required": ["$types"],
          "not": {
            "required": ["type"]
          }
        }
      ]
    },
    {
      "not": {
        "required": ["subtype", "$subtypes"]
      }
    }
  ]
}
