{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/work-management/template-metadata.json",
  "title": "work-management/template-metadata",
  "description": "Template frontmatter contract for templjs-authored work-management templates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$content_schema"
  ],
  "properties": {
    "type": {
      "$ref": "./support/common.json#/$defs/primaryType"
    },
    "$types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./support/common.json#/$defs/primaryType"
      }
    },
    "subtype": {
      "$ref": "./support/common.json#/$defs/nonEmptyString"
    },
    "$subtypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./support/common.json#/$defs/nonEmptyString"
      }
    },
    "$schema": {
      "$ref": "./support/common.json#/$defs/frontmatterSchemaRef"
    },
    "$content_schema": {
      "$ref": "./support/common.json#/$defs/contentSchemaRef"
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "type"
          ],
          "not": {
            "required": [
              "$types"
            ]
          }
        },
        {
          "required": [
            "$types"
          ],
          "not": {
            "required": [
              "type"
            ]
          }
        }
      ]
    },
    {
      "not": {
        "required": [
          "subtype",
          "$subtypes"
        ]
      }
    }
  ]
}
