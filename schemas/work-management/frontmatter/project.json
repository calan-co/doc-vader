{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/work-management/frontmatter/project",
  "title": "work-management/frontmatter/project",
  "type": "object",
  "unevaluatedProperties": false,
  "allOf": [
    {
      "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/1.0.0#/$defs/core"
    },
    {
      "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/1.0.0#/$defs/lifecycleStatusCompatibility"
    },
    {
      "$ref": "/work-management/support/common#/$defs/correlationFields"
    },
    {
      "$ref": "/work-management/support/common#/$defs/assignableFields"
    },
    {
      "type": "object",
      "required": ["$schema", "summary"],
      "properties": {
        "$schema": {
          "const": "schemas/work-management/frontmatter/project.json"
        },
        "id": {
          "type": "string",
          "pattern": "^project:[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": {
          "const": "project",
          "description": "The type of the document. Always 'project' for this schema"
        },
        "subtype": {
          "$ref": "/work-management/support/common#/$defs/projectSubtype",
          "description": "The subtype of the project (e.g., program, initiative), providing more specific categorization"
        },
        "summary": {
          "$ref": "/work-management/support/common#/$defs/nonEmptyString"
        }
      }
    }
  ]
}
