{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/work-management/content/plan",
  "title": "work-management/content/plan",
  "type": "object",
  "required": [
    "entityType",
    "intent",
    "methodology",
    "assumptions",
    "constraints",
    "entries",
    "relationships"
  ],
  "properties": {
    "entityType": {
      "const": "plan"
    },
    "intent": {
      "$ref": "/work-management/support/common#/$defs/nonEmptyString"
    },
    "methodology": {
      "$ref": "/work-management/support/common#/$defs/methodology"
    },
    "assumptions": {
      "$ref": "/work-management/support/common#/$defs/stringList"
    },
    "constraints": {
      "$ref": "/work-management/support/common#/$defs/stringList"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "/work-management/support/common#/$defs/planEntry"
      }
    },
    "relationships": {
      "$ref": "/work-management/support/common#/$defs/nonEmptyRelationshipList"
    },
    "notes": {
      "$ref": "/work-management/support/common#/$defs/notesValue"
    }
  },
  "additionalProperties": false
}
