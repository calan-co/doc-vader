    },
    "releaseObjective": {
      "$ref": "/work-management/support/common#/$defs/nonEmptyString"
    },
    "releaseScope": {
      "$ref": "/work-management/support/common#/$defs/stringList"
    },
    "readinessGates": {
      "$ref": "/work-management/support/common#/$defs/stringList"
    },
    "rolloutNotes": {
      "$ref": "/work-management/support/common#/$defs/stringList"
    },
    "relationships": {
      "$ref": "/work-management/support/common#/$defs/nonEmptyRelationshipList"
    },
    "notes": {
      "$ref": "/work-management/support/common#/$defs/notesValue"
    }
  },
  "additionalProperties": false
}
