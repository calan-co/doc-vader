{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/work-management/content/record",
  "title": "work-management/content/record",
  "type": "object",
  "required": ["entityType", "recordedAt", "observation", "subjectRefs"],
  "properties": {
    "entityType": {
      "const": "record"
    },
    "recordedAt": {
      "$ref": "/work-management/support/common#/$defs/dateTimeString"
    },
    "outcome": {
      "$ref": "/work-management/support/common#/$defs/recordOutcome"
    },
    "observation": {
      "$ref": "/work-management/support/common#/$defs/nonEmptyString"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "/work-management/support/common#/$defs/nonEmptyString"
      }
    },
    "subjectRefs": {
      "$ref": "/work-management/support/common#/$defs/entityRefList"
    },
    "artifactRefs": {
      "$ref": "/work-management/support/common#/$defs/supportingRefList"
    },
    "notes": {
      "$ref": "/work-management/support/common#/$defs/notesValue"
    }
  },
  "additionalProperties": false
}
