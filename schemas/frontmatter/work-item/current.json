{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/frontmatter/work-item/1.0.0",
  "title": "frontmatter/work-item",
  "description": "Strict frontmatter schema for backlog work items supporting SDLC and Diataxis standards.",
  "allOf": [
    { "$ref": "/frontmatter/document/1.0.0" },
    {
      "type": "object",
      "required": ["priority"],
      "properties": {
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "assignee": { "type": "string" },
        "workItemType": { "type": "string" },
        "name": { "type": "string" },
        "created": {
          "oneOf": [{ "type": "string" }, { "type": "object" }]
        },
        "modified": {
          "oneOf": [{ "type": "string" }, { "type": "object" }]
        },
        "status_comment": { "type": "string" },
        "relations": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": true
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "ref"],
                "properties": {
                  "type": { "type": "string" },
                  "ref": { "type": "string" },
                  "note": { "type": "string" }
                },
                "additionalProperties": true
              }
            }
          ]
        },
        "classifications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "status_reason": {
          "type": "string",
          "enum": [
            "success",
            "obsolete",
            "redundant",
            "superseded",
            "cancelled"
          ],
          "description": "Required when status is 'closed' to capture why the work item was closed."
        },
        "ordinal": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "closed" } }
          },
          "then": { "required": ["status_reason"] }
        }
      ]
    }
  ]
}
