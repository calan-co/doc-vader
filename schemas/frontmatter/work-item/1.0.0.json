{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doc-vader/schemas/frontmatter/document/1.0.0.json",
  "title": "frontmatter/work-item",
  "description": "Strict frontmatter schema for backlog work items supporting SDLC and Diataxis standards.",
  "allOf": [
    { "$ref": "/frontmatter/document/1.0.0" },
    {
      "type": "object",
      "required": ["priority"],
      "properties": {
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "assignee": { "type": "string" },
        "ordinal": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991
        }
      }
    }
  ]
}
