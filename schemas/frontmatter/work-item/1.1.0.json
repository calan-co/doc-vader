{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/frontmatter/work-item/1.1.0",
  "title": "frontmatter/work-item/changed-files-policy",
  "description": "Incremental policy schema for changed work-items. Intended for changed-file gates, not full historical backlog validation.",
  "type": "object",
  "properties": {
    "status": {
      "type": "string"
    },
    "status_reason": {
      "type": "string"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "actual": {
      "type": "number",
      "minimum": 0
    },
    "links": {
      "type": "object",
      "properties": {
        "pull_requests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "completed",
              "aborted",
              "closed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "status_reason",
          "completed_date",
          "actual",
          "links"
        ],
        "properties": {
          "status_reason": {
            "enum": [
              "success",
              "completed",
              "awaiting-review",
              "verification-pending",
              "implementation-complete",
              "rejected",
              "obsolete",
              "redundant",
              "superseded",
              "cancelled",
              "duplicate",
              "wontfix"
            ]
          },
          "links": {
            "required": [
              "pull_requests"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "completed",
              "ready-for-review"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "links"
        ],
        "properties": {
          "links": {
            "required": [
              "pull_requests"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "completed_date"
        ]
      },
      "then": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "completed",
              "aborted",
              "closed"
            ]
          }
        }
      }
    }
  ]
}
