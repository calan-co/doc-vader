{
  "title": "frontmatter/overlays/governance-mode.vocab.core",
  "$id": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/overlays/governance-mode.vocab.core/current",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "coreToken": {
      "type": "string",
      "enum": [
        "strict",
        "advisory"
      ]
    },
    "token": {
      "oneOf": [
        {
          "$ref": "#/$defs/coreToken"
        },
        {
          "type": "string",
          "maxLength": 64,
          "pattern": "^x-[A-Za-z][A-Za-z0-9_-]*$"
        }
      ]
    }
  },
  "version": "1.0.0"
}