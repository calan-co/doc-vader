{
  "title": "frontmatter/overlays/audience-token.vocab.core",
  "$id": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/overlays/audience-token.vocab.core/current",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "coreToken": {
      "type": "string",
      "enum": [
        "integrators",
        "contributors",
        "operators",
        "endUsers",
        "administrators",
        "executives"
      ]
    },
    "token": {
      "oneOf": [
        {
          "$ref": "#/$defs/coreToken"
        },
        {
          "type": "string",
          "maxLength": 64,
          "pattern": "^x-[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      ]
    }
  },
  "version": "1.0.0"
}