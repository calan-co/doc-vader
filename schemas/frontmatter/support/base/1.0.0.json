{
  "title": "frontmatter/base",
  "description": "Shared building blocks and rules for frontmatter schemas.",
  "$id": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "audience": {
      "description": "List of intended audiences.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/audienceToken"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "audienceToken": {
      "allOf": [
        {
          "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/contracts/audience-token.contract/current"
        },
        {
          "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/overlays/audience-token.vocab.core/current#/$defs/token"
        }
      ]
    },
    "classification": {
      "description": "Classification(s) for the document, such as diataxis, sensitivity, or compliance.",
      "oneOf": [
        {
          "$ref": "#/$defs/classificationToken"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/classificationToken"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9_-]*$": {
              "oneOf": [
                {
                  "$ref": "#/$defs/classificationToken"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/classificationToken"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              ]
            }
          },
          "propertyNames": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        }
      ]
    },
    "classificationToken": {
      "allOf": [
        {
          "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/contracts/classification-token.contract/current"
        },
        {
          "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/overlays/classification-token.vocab.core/current#/$defs/token"
        }
      ]
    },
    "core": {
      "type": "object",
      "required": [
        "id",
        "title",
        "type",
        "subtype",
        "lifecycle",
        "status"
      ],
      "properties": {
        "title": {
          "description": "Human-readable document title.",
          "type": "string"
        },
        "type": {
          "description": "High-level type of the document (e.g., work-item, document).",
          "type": "string"
        },
        "audience": {
          "$ref": "#/$defs/audience"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "governance": {
          "$ref": "#/$defs/governance"
        },
        "id": {
          "description": "Unique identifier for the document or work item.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "links": {
          "$ref": "#/$defs/links"
        },
        "owner": {
          "description": "Primary owner or responsible party for the document.",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "status_reason": {
          "$ref": "#/$defs/statusReasonValue"
        },
        "subtype": {
          "description": "Specific subtype of the document for classification and navigation.",
          "type": "string"
        },
        "summary": {
          "description": "Short summary describing the document's purpose or content.",
          "type": "string"
        },
        "tags": {
          "description": "List of tags for search, filtering, and organization.",
          "type": "array",
          "items": {
            "description": "Single tag in kebab-case (e.g., 'user-guide', 'api-reference').",
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "minItems": 1
        }
      },
      "patternProperties": {
        "^\\$[a-zA-Z0-9_]+$": {
          "$ref": "#/$defs/toolingProperty"
        }
      },
      "propertyNames": {
        "maxLength": 128
      }
    },
    "governance": {
      "description": "Governance configuration: profiles (documentation systems, process models) and optional reconciliation strategies.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profiles"
      ],
      "properties": {
        "profiles": {
          "description": "List or map of governance profiles controlling structure/process rules.",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
              },
              "minProperties": 1,
              "patternProperties": {
                "^[A-Za-z][A-Za-z0-9_-]*$": {
                  "$ref": "#/$defs/governanceProfileValue"
                }
              },
              "propertyNames": {
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              }
            }
          ]
        },
        "reconciliation": {
          "description": "Conflict resolution configuration across selected profiles.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaultStrategy": {
              "$ref": "#/$defs/reconciliationStrategy"
            },
            "strategies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "appliesTo",
                  "strategy"
                ],
                "properties": {
                  "appliesTo": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "profiles"
                    ],
                    "properties": {
                      "conflictTypes": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "structure",
                            "taxonomy",
                            "lifecycle",
                            "status",
                            "fields",
                            "sensitivity",
                            "naming",
                            "other"
                          ]
                        },
                        "minItems": 1
                      },
                      "profiles": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 2,
                        "uniqueItems": true
                      }
                    }
                  },
                  "notes": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "overrideProfile": {
                    "type": "string",
                    "minLength": 1
                  },
                  "strategy": {
                    "$ref": "#/$defs/reconciliationStrategy"
                  }
                }
              }
            }
          }
        }
      }
    },
    "governanceMode": {
      "allOf": [
        {
          "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/contracts/governance-mode.contract/current"
        },
        {
          "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/overlays/governance-mode.vocab.core/current#/$defs/token"
        }
      ]
    },
    "governanceProfileValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/governanceMode"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "$ref": "#/$defs/governanceMode"
            },
            "notes": {
              "type": "string",
              "maxLength": 512
            },
            "version": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
            }
          }
        }
      ]
    },
    "lifecycle": {
      "description": "Long-term state of the document.",
      "type": "string",
      "enum": [
        "draft",
        "active",
        "evergreen",
        "inactive"
      ]
    },
    "lifecycleStatusCompatibility": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "lifecycle": {
              "const": "draft"
            },
            "status": {
              "enum": [
                "proposed",
                "closed"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "lifecycle": {
              "const": "active"
            },
            "status": {
              "enum": [
                "ready",
                "in-progress",
                "ready-for-review",
                "closed"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "lifecycle": {
              "const": "evergreen"
            },
            "status": {
              "enum": [
                "ready",
                "in-progress",
                "ready-for-review",
                "closed"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "lifecycle": {
              "const": "inactive"
            },
            "status": {
              "enum": [
                "closed"
              ]
            }
          }
        }
      ]
    },
    "link": {
      "description": "Link to a related document or resource.",
      "anyOf": [
        {
          "$ref": "#/$defs/uri"
        },
        {
          "$ref": "#/$defs/wikilink"
        }
      ]
    },
    "links": {
      "description": "Links to related documents, guides, or examples. Only include a note if it materially clarifies the purpose or context of the link. Do not add notes that simply restate the link or add generic information.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
      },
      "minProperties": 1,
      "patternProperties": {
        "^.+$": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/link"
              },
              {
                "$ref": "#/$defs/linkWithNote"
              }
            ]
          }
        }
      },
      "propertyNames": {
        "maxLength": 128,
        "pattern": "^.+$"
      }
    },
    "linkWithNote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "link": {
          "$ref": "#/$defs/link"
        },
        "note": {
          "$ref": "#/$defs/note"
        },
        "ref": {
          "$ref": "#/$defs/link"
        }
      },
      "oneOf": [
        {
          "required": [
            "ref"
          ]
        },
        {
          "required": [
            "link"
          ]
        }
      ]
    },
    "note": {
      "description": "Adds meaningful context or value.",
      "type": "string"
    },
    "noteWithTimestamp": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "timestamp",
        "note"
      ],
      "properties": {
        "note": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/note"
              }
            },
            {
              "type": "object",
              "additionalProperties": true,
              "minProperties": 1
            },
            {
              "$ref": "#/$defs/note"
            }
          ]
        },
        "timestamp": {
          "description": "ISO 8601 timestamp of when the note was added.",
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "reconciliationStrategy": {
      "oneOf": [
        {
          "$ref": "#/$defs/reconciliationStrategyToken"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "override"
          ],
          "properties": {
            "override": {
              "description": "Profile name to use as override when strategy=override; must reference a declared profile.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prioritize"
          ],
          "properties": {
            "prioritize": {
              "description": "Explicit precedence order applied when strategy=prioritize; names must reference declared profiles.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2,
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "reconciliationStrategyToken": {
      "allOf": [
        {
          "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/contracts/reconciliation-strategy-token.contract/current"
        },
        {
          "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/overlays/reconciliation-strategy-token.vocab.core/current#/$defs/token"
        }
      ]
    },
    "status": {
      "description": "Current actionable workflow state.",
      "type": "string",
      "enum": [
        "proposed",
        "ready",
        "in-progress",
        "ready-for-review",
        "closed"
      ]
    },
    "statusReasonExtensionToken": {
      "allOf": [
        {
          "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/contracts/status-reason-token.contract/current"
        },
        {
          "not": {
            "$ref": "#/$defs/statusReasonKnown"
          }
        }
      ]
    },
    "statusReasonFreeform": {
      "description": "Free-form reason. If a well-known reason exists, use the canonical token instead.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "$ref": "#/$defs/statusReasonKnown"
          },
          {
            "$ref": "#/$defs/statusReasonExtensionToken"
          }
        ]
      }
    },
    "statusReasonKnown": {
      "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/overlays/status-reason-token.vocab.core/current#/$defs/coreToken"
    },
    "statusReasonValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/statusReasonKnown"
        },
        {
          "$ref": "#/$defs/statusReasonExtensionToken"
        },
        {
          "$ref": "#/$defs/statusReasonFreeform"
        }
      ]
    },
    "statusTransitions": {
      "description": "Canonical allowed status transitions for documentation/work items. Used by scripts to enforce valid status changes.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "closed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 0
        },
        "in-progress": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ready-for-review",
              "closed"
            ]
          }
        },
        "proposed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ready",
              "closed"
            ]
          }
        },
        "ready": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "in-progress",
              "closed"
            ]
          }
        },
        "ready-for-review": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "closed"
            ]
          }
        }
      },
      "examples": [
        {
          "proposed": [
            "ready",
            "closed"
          ]
        }
      ]
    },
    "toolingProperty": {
      "description": "Allow custom properties starting with $ for tooling purposes.",
      "oneOf": [
        {
          "$ref": "#/$defs/toolingScalar"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolingScalar"
          },
          "maxItems": 64
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/toolingScalar"
          },
          "maxProperties": 64,
          "propertyNames": {
            "maxLength": 64
          }
        }
      ]
    },
    "toolingScalar": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 1024
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "uri": {
      "description": "Uri to an external resource.",
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:(?:\\[(?<text>.+?)\\])?\\(?(?:(?<protocol>(?:[^:]+)s?):\\/\\/)(?:(?<user>[^:\\n\\r]+):(?<pass>[^@\\n\\r]+)@)?(?<host>(?:www\\.)?(?:[^:\\/\\n\\r]+))(?::(?<port>\\d+))?\\/?(?<resource>[^?#\\n\\r]+)?\\??(?<query>[^#\\n\\r]*)?#?(?<anchor>[^\\n\\r]*)?\\)?)$"
    },
    "wikilink": {
      "description": "Wikilink to a markdown document in this repository.",
      "type": "string",
      "maxLength": 128,
      "pattern": "^\\[\\[(?<name>[^\\]\\|\\r\\n]+)(?:\\|(?<title>[^\\]\\|\\r\\n]+))?\\]\\](?<agglu>[^\\p{P}\\s]*)$"
    }
  },
  "version": "1.0.0"
}