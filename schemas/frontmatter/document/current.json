{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/frontmatter/document/1.0.0",
  "$versioningScheme": "semver",
  "title": "frontmatter/document",
  "description": "Defines the required and recommended frontmatter fields for all markdown documentation files in this project. Use this schema to validate and standardize document metadata.",
  "type": "object",
  "required": ["id", "title", "type", "subtype", "lifecycle", "status"],
  "unevaluatedProperties": false,
  "definitions": {
    "note": {
      "type": "string",
      "description": "Optional. Only include when it adds meaningful context or value."
    },
    "wikilink": {
      "type": "string",
      "pattern": "^\\[\\[(?<name>[^\\]\\|\\r\\n]+)(?:\\|(?<title>[^\\]\\|\\r\\n]+))?\\]\\](?<agglu>[^\\p{P}\\s]*)$",
      "maxLength": 128,
      "description": "Wikilink to a markdown document in this repository."
    },
    "uri": {
      "type": "string",
      "pattern": "^(?:(?:\\[(?<text>.+?)\\])?\\(?(?:(?<protocol>(?:[^:]+)s?)?:\\/\\/)?(?:(?<user>[^:\\n\\r]+):(?<pass>[^@\\n\\r]+)@)?(?<host>(?:www\\.)?(?:[^:\\/\\n\\r]+))(?::(?<port>\\d+))?\\/?(?<resource>[^?#\\n\\r]+)?\\??(?<query>[^#\\n\\r]*)?#?(?<anchor>[^\\n\\r]*)?\\)?)$",
      "maxLength": 256,
      "description": "Uri to an external resource."
    },
    "link": {
      "anyOf": [
        { "$ref": "#/definitions/uri" },
        { "$ref": "#/definitions/wikilink" }
      ],
      "description": "Link to a related document or resource."
    }
  },
  "patternProperties": {
    "^\\$[a-zA-Z0-9_]+$": {
      "description": "Allow custom properties starting with $ for tooling purposes."
    }
  },
  "propertyNames": { "maxLength": 128 },
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the document or work item."
    },
    "title": {
      "type": "string",
      "description": "Human-readable document title."
    },
    "summary": {
      "type": "string",
      "description": "Short summary describing the document's purpose or content."
    },
    "owner": {
      "type": "string",
      "description": "Primary owner or responsible party for the document."
    },
    "type": {
      "type": "string",
      "enum": ["work-item", "document"],
      "description": "High-level type of the document (e.g., work-item, document)."
    },
    "subtype": {
      "type": "string",
      "description": "Specific subtype of the document for classification and navigation."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 64,
        "description": "Single tag in kebab-case (e.g., 'user-guide', 'api-reference')."
      },
      "minItems": 1,
      "description": "List of tags for search, filtering, and organization."
    },
    "links": {
      "type": "object",
      "description": "Links to related documents, guides, or examples. Only include a note if it materially clarifies the purpose or context of the link. Do not add notes that simply restate the link or add generic information.",
      "properties": {},
      "patternProperties": {
        "^.+$": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/link" },
              {
                "type": "object",
                "required": ["ref"],
                "properties": {
                  "ref": { "$ref": "#/definitions/link" },
                  "note": { "$ref": "#/definitions/note" }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "propertyNames": { "pattern": "^.+$", "maxLength": 128 },
      "additionalProperties": false,
      "minProperties": 1
    },
    "classification": {
      "type": "object",
      "required": ["diataxis", "sensitivity"],
      "properties": {
        "diataxis": {
          "definitions": {
            "diataxisCategory": {
              "type": "string",
              "enum": ["tutorial", "how-to", "reference", "explanation"],
              "description": "Diataxis category."
            }
          },
          "description": "Diataxis classification for the document.",
          "oneOf": [
            {
              "type": "string",
              "$ref": "#/properties/classification/properties/diataxis/definitions/diataxisCategory"
            },
            {
              "type": "object",
              "required": ["category"],
              "properties": {
                "category": {
                  "type": "string",
                  "$ref": "#/properties/classification/properties/diataxis/definitions/diataxisCategory"
                },
                "note": {
                  "type": "string",
                  "$ref": "#/definitions/note"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "sensitivity": {
          "definitions": {
            "sensitivityLabel": {
              "type": "string",
              "enum": ["public", "internal", "confidential", "restricted"],
              "description": "Sensitivity level of the document."
            }
          },
          "oneOf": [
            {
              "$ref": "#/properties/classification/properties/sensitivity/definitions/sensitivityLabel"
            },
            {
              "type": "object",
              "required": ["label"],
              "properties": {
                "label": {
                  "type": "string",
                  "$ref": "#/properties/classification/properties/sensitivity/definitions/sensitivityLabel"
                },
                "note": {
                  "type": "string",
                  "$ref": "#/definitions/note"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "compliance": {
          "type": "object",
          "description": "Compliance frameworks and their applicability.",
          "properties": {},
          "patternProperties": {
            "^[A-Za-z-][A-Za-z0-9-]*$": {
              "type": "string",
              "enum": ["inScope", "outOfScope"],
              "description": "Compliance framework (e.g., 'GDPR': 'inScope', 'PCI': 'outOfScope')."
            }
          },
          "propertyNames": {
            "pattern": "^[A-Za-z-][A-Za-z0-9-]*$",
            "maxLength": 128
          },
          "minProperties": 1,
          "additionalProperties": false
        }
      },
      "description": "Classification(s) for the document, such as diataxis, sensitivity, or compliance."
    },
    "lifecycle": {
      "type": "string",
      "enum": ["draft", "active", "evergreen", "archived", "obsolete"],
      "description": "Long-term state of the document or work item."
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "inProgress",
        "review",
        "approved",
        "complete",
        "deprecated",
        "superseded",
        "rejected",
        "duplicate"
      ],
      "description": "Current actionable workflow state."
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "integrators",
              "contributors",
              "operators",
              "endUsers",
              "administrators",
              "executives"
            ],
            "maxLength": 32,
            "description": "Intended audience for the document."
          },
          {
            "type": "string",
            "not": {
              "enum": [
                "integrators",
                "contributors",
                "operators",
                "endUsers",
                "administrators",
                "executives"
              ]
            },
            "maxLength": 32,
            "description": "Intended audience for the document."
          }
        ]
      },
      "description": "List of intended audiences."
    },
    "governance": {
      "type": "object",
      "description": "Governance configuration: profiles (documentation systems, process models) and optional reconciliation strategies.",
      "required": ["profiles"],
      "properties": {
        "profiles": {
          "description": "List or map of governance profiles controlling structure/process rules.",
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            {
              "type": "object",
              "minProperties": 1,
              "properties": {},
              "patternProperties": {
                "^[A-Za-z][A-Za-z0-9_-]*$": {
                  "oneOf": [
                    { "type": "string", "enum": ["strict", "advisory"] },
                    {
                      "type": "object",
                      "properties": {
                        "mode": {
                          "type": "string",
                          "enum": ["strict", "advisory"]
                        },
                        "version": {
                          "type": "string",
                          "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
                          "maxLength": 128
                        },
                        "notes": { "type": "string", "maxLength": 512 }
                      },
                      "required": ["mode"],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "propertyNames": {
                "pattern": "^[A-Za-z-][A-Za-z0-9-]*$",
                "maxLength": 128
              },
              "additionalProperties": false
            }
          ]
        },
        "reconciliation": {
          "definitions": {
            "ReconciliationStrategy": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "prompt",
                    "auto",
                    "intersection",
                    "split",
                    "advisory"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "override": {
                      "type": "string",
                      "description": "Profile name to use as override when strategy=override; must reference a declared profile.",
                      "minLength": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "required": ["prioritize"],
                  "properties": {
                    "prioritize": {
                      "type": "array",
                      "description": "Explicit precedence order applied when strategy=prioritize; names must reference declared profiles.",
                      "items": { "type": "string", "minLength": 1 },
                      "uniqueItems": true,
                      "minItems": 2
                    }
                  }
                }
              ]
            }
          },
          "type": "object",
          "description": "Conflict resolution configuration across selected profiles.",
          "properties": {
            "defaultStrategy": {
              "type": "string",
              "$ref": "#/properties/governance/properties/reconciliation/definitions/ReconciliationStrategy"
            },
            "strategies": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["appliesTo", "strategy"],
                "properties": {
                  "appliesTo": {
                    "type": "object",
                    "required": ["profiles"],
                    "properties": {
                      "profiles": {
                        "type": "array",
                        "minItems": 2,
                        "items": { "type": "string", "minLength": 1 },
                        "uniqueItems": true
                      },
                      "conflictTypes": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "enum": [
                            "structure",
                            "taxonomy",
                            "lifecycle",
                            "status",
                            "fields",
                            "sensitivity",
                            "naming",
                            "other"
                          ]
                        }
                      }
                    },
                    "additionalProperties": false
                  },
                  "strategy": {
                    "type": "string",
                    "$ref": "#/properties/governance/properties/reconciliation/definitions/ReconciliationStrategy"
                  },
                  "overrideProfile": { "type": "string", "minLength": 1 },
                  "notes": { "type": "string", "maxLength": 512 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "statusTransitions": {
    "description": "Canonical allowed status transitions for documentation/work items. Used by scripts to enforce valid status changes.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "proposed": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["accepted", "review", "rejected", "duplicate"]
        }
      },
      "accepted": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["inProgress", "review", "approved", "rejected", "duplicate"]
        }
      },
      "inProgress": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["review", "approved", "complete", "rejected", "duplicate"]
        }
      },
      "review": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["approved", "rejected", "duplicate"]
        }
      },
      "approved": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["complete", "deprecated", "superseded"]
        }
      },
      "complete": {
        "type": "array",
        "items": { "type": "string", "enum": ["deprecated", "superseded"] }
      },
      "deprecated": {
        "type": "array",
        "items": { "type": "string", "enum": ["superseded", "archived"] }
      },
      "superseded": {
        "type": "array",
        "items": { "type": "string", "enum": ["archived"] }
      },
      "rejected": {
        "type": "array",
        "items": { "type": "string", "enum": ["archived"] }
      },
      "duplicate": {
        "type": "array",
        "items": { "type": "string", "enum": ["archived"] }
      }
    },
    "examples": [
      { "proposed": ["accepted", "review", "rejected", "duplicate"] }
    ]
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "lifecycle": { "const": "draft" },
        "status": {
          "enum": [
            "proposed",
            "accepted",
            "inProgress",
            "review",
            "rejected",
            "duplicate"
          ]
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "lifecycle": { "const": "active" },
        "status": {
          "enum": ["accepted", "inProgress", "review", "approved", "complete"]
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "lifecycle": { "const": "evergreen" },
        "status": {
          "enum": [
            "accepted",
            "inProgress",
            "complete",
            "approved",
            "deprecated"
          ]
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "lifecycle": { "const": "archived" },
        "status": {
          "enum": [
            "complete",
            "deprecated",
            "superseded",
            "rejected",
            "duplicate"
          ]
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "lifecycle": { "const": "obsolete" },
        "status": { "enum": ["superseded", "archived", "deprecated"] }
      }
    }
  ]
}
