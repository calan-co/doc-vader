{
  "title": "frontmatter/document",
  "description": "Defines the required and recommended frontmatter fields for all markdown documentation files in this project. Use this schema to validate and standardize document metadata.",
  "$id": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/by-type/document/current",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/current#/$defs/core"
    },
    {
      "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/current#/$defs/lifecycleStatusCompatibility"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "description": "High-level type of the document (e.g., work-item, document).",
          "type": "string",
          "const": "document"
        },
        "id": {
          "description": "Unique identifier for the document.",
          "type": "string",
          "pattern": "^[a-z]{2,}-\\d+$"
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "version": "1.0.0",
  "x-statusTransitions": {
    "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/current#/$defs/statusTransitions"
  }
}