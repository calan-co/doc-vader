{
  "title": "frontmatter/work-item",
  "description": "Strict frontmatter schema for work items.",
  "$id": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/by-type/work-item/current",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/current#/$defs/core"
    },
    {
      "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/current#/$defs/lifecycleStatusCompatibility"
    },
    {
      "type": "object",
      "required": [
        "priority",
        "estimated"
      ],
      "properties": {
        "type": {
          "description": "High-level type of the document (e.g., work-item, document).",
          "type": "string",
          "const": "work-item"
        },
        "actual": {
          "description": "Optional field to capture the actual effort spent on the work item. Useful for tracking and improving estimation accuracy over time.",
          "type": "number",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "assignee": {
          "description": "Person responsible for the work item.",
          "type": "string"
        },
        "commits": {
          "description": "Map of commit SHAs to their commit messages. Tracks all commits related to this work item.",
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^(?:[0-9a-f]{7}|[0-9a-f]{40})$": {
              "description": "Description or title of the commit associated with the commit SHA (i.e., `git show <commit_sha> -s --format=%s`).",
              "type": "string",
              "minLength": 10
            }
          },
          "propertyNames": {
            "maxLength": 256
          }
        },
        "completed_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "complexity": {
          "description": "Optional field to indicate the estimated complexity of the work item, which can help with planning and resource allocation.",
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "estimated": {
          "description": "Captures the estimated effort required to complete the work item.",
          "type": "number",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "execution": {
          "description": "Optional execution tracking for epics managing multiple work items. Defines phases, concurrency modes, and current progress.",
          "type": "object",
          "properties": {
            "current_item": {
              "description": "ID of the work item currently being executed.",
              "type": "string"
            },
            "current_phase": {
              "description": "Name of the currently active phase.",
              "type": "string"
            },
            "phases": {
              "description": "Hierarchical execution plan with sequential or parallel phases.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/executionPhase"
              },
              "minItems": 1
            }
          }
        },
        "id": {
          "description": "Unique identifier for the document or work item.",
          "type": "string",
          "pattern": "^wi-\\d+$"
        },
        "links": {
          "description": "Links to pull requests and dependencies.",
          "type": "object",
          "properties": {
            "depends_on": {
              "description": "Array of work item links (wikilinks for local repos, URIs for cross-repo dependencies) that must be completed before this work item can start.",
              "type": "array",
              "items": {
                "description": "Link to another work item that this work item depends on.",
                "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/current#/$defs/link"
              },
              "minItems": 1
            },
            "pull_requests": {
              "description": "Array of GitHub PR URLs related to this work item.",
              "type": "array",
              "items": {
                "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/current#/$defs/link"
              },
              "minItems": 1
            }
          }
        },
        "notes": {
          "description": "Optional field for any additional notes or context about the work item.",
          "type": "array",
          "items": {
            "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/current#/$defs/noteWithTimestamp"
          }
        },
        "ordinal": {
          "description": "Optional field for manual ordering or ranking of work items.",
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991
        },
        "priority": {
          "description": "Priority level of the work item, indicating its importance and urgency.",
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "subtype": {
          "description": "Specific subtype of the document for classification and navigation.",
          "type": "string",
          "enum": [
            "story",
            "task",
            "bug",
            "epic",
            "spike"
          ]
        },
        "test_results": {
          "type": "array",
          "items": {
            "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/current#/$defs/noteWithTimestamp"
          },
          "minItems": 1
        }
      }
    },
    {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "proposed"
            },
            "status_reason": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "needs-triage",
                    "awaiting-approval",
                    "deferred",
                    "blocked-by-dependency"
                  ]
                },
                {
                  "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/current#/$defs/statusReasonExtensionToken"
                },
                {
                  "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/current#/$defs/statusReasonFreeform"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "ready"
            },
            "status_reason": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "prioritized",
                    "scheduled",
                    "dependencies-cleared"
                  ]
                },
                {
                  "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/current#/$defs/statusReasonExtensionToken"
                },
                {
                  "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/current#/$defs/statusReasonFreeform"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "in-progress"
            },
            "status_reason": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "implementation",
                    "investigation",
                    "blocked",
                    "waiting-on-feedback"
                  ]
                },
                {
                  "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/current#/$defs/statusReasonExtensionToken"
                },
                {
                  "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/current#/$defs/statusReasonFreeform"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "ready-for-review"
            },
            "status_reason": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "awaiting-review",
                    "changes-requested",
                    "verification-pending"
                  ]
                },
                {
                  "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/current#/$defs/statusReasonExtensionToken"
                },
                {
                  "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/current#/$defs/statusReasonFreeform"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status_reason"
          ],
          "properties": {
            "status": {
              "const": "closed"
            },
            "status_reason": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "completed",
                    "rejected",
                    "duplicate",
                    "obsolete",
                    "cancelled"
                  ]
                },
                {
                  "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/current#/$defs/statusReasonExtensionToken"
                },
                {
                  "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/current#/$defs/statusReasonFreeform"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "if": {
        "type": "object",
        "required": [
          "status_reason"
        ],
        "properties": {
          "status_reason": {
            "const": "completed"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "status": {
            "const": "closed"
          }
        }
      }
    }
  ],
  "$defs": {
    "executionPhase": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "items": {
          "description": "Leaf-level work item IDs. Mutually exclusive with 'phases'.",
          "type": "array",
          "items": {
            "description": "Work item ID (e.g., '172.1', '172.2.3').",
            "type": "string"
          },
          "minItems": 1
        },
        "mode": {
          "description": "Execution mode: sequential (items/phases execute one after another) or parallel (items/phases can execute concurrently).",
          "type": "string",
          "enum": [
            "sequential",
            "parallel"
          ]
        },
        "name": {
          "description": "Name of this execution phase or group.",
          "type": "string"
        },
        "phases": {
          "description": "Nested execution phases for hierarchical planning. Mutually exclusive with 'items'.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/executionPhase"
          },
          "minItems": 1
        },
        "status": {
          "description": "Current status of this phase.",
          "type": "string",
          "enum": [
            "not-started",
            "in-progress",
            "completed"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "items"
          ],
          "not": {
            "required": [
              "phases"
            ]
          }
        },
        {
          "required": [
            "phases"
          ],
          "not": {
            "required": [
              "items"
            ]
          }
        }
      ]
    }
  },
  "unevaluatedProperties": false,
  "version": "1.0.0",
  "x-statusTransitions": {
    "$ref": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/support/base/current#/$defs/statusTransitions"
  },
  "": "https://raw.githubusercontent.com/calan-co/doc-vader/main/schemas/frontmatter/by-type/work-item/current"
}
