{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/doc-vader/document-type-pack",
  "title": "doc-vader/document-type-pack",
  "description": "Manifest contract for a Doc-Vader document type pack that contributes metadata schemas, content schemas, templates, optional commands, and optional routing defaults.",
  "type": "object",
  "required": ["schemaVersion", "namespace", "documentTypes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "doc-vader/document-type-pack/v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "documentTypes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/documentType" }
    },
    "templates": {
      "type": "array",
      "items": { "$ref": "#/$defs/template" }
    },
    "commands": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "checklistDefinitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/checklistDefinition" },
      "uniqueItems": true
    },
    "configDefaults": {
      "$ref": "/doc-vader/config"
    }
  },
  "$defs": {
    "routingToken": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "documentType": {
      "type": "object",
      "required": ["type", "metadataSchema"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/routingToken" },
        "subtypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/routingToken" },
          "uniqueItems": true
        },
        "metadataSchema": {
          "type": "string",
          "minLength": 1
        },
        "contentSchema": {
          "type": "string",
          "minLength": 1
        },
        "handler": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checklistDefinition": {
      "type": "object",
      "required": ["id", "heading"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/routingToken" },
        "heading": { "type": "string", "minLength": 1 }
      }
    },
    "template": {
      "type": "object",
      "required": ["path", "type"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/routingToken" },
        "subtype": { "$ref": "#/$defs/routingToken" }
      }
    }
  }
}
