{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/doc-vader/document-type-pack",
  "title": "doc-vader/document-type-pack",
  "description": "Manifest contract for a Doc-Vader document type pack that contributes metadata schemas, content schemas, templates, optional commands, and optional routing defaults.",
  "type": "object",
  "required": ["schemaVersion", "namespace", "documentTypes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "doc-vader/document-type-pack/v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "documentTypes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/documentType" }
    },
    "templates": {
      "type": "array",
      "items": { "$ref": "#/$defs/template" }
    },
    "commands": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "configDefaults": {
      "$ref": "/doc-vader/config#/$defs/documentRouting"
    },
    "init": {
      "$ref": "#/$defs/initRecipe"
    }
  },
  "$defs": {
    "routingToken": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "documentType": {
      "type": "object",
      "required": ["type", "metadataSchema"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/routingToken" },
        "subtypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/routingToken" },
          "uniqueItems": true
        },
        "metadataSchema": {
          "type": "string",
          "minLength": 1
        },
        "contentSchema": {
          "type": "string",
          "minLength": 1
        },
        "handler": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "template": {
      "type": "object",
      "required": ["path", "type"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/routingToken" },
        "subtype": { "$ref": "#/$defs/routingToken" }
      }
    },
    "initConfigValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "pattern": "^[^\\r\\n]*$" },
        { "$ref": "#/$defs/initConfigObject" }
      ]
    },
    "initConfigObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/initConfigValue" }
    },
    "initRecipe": {
      "type": "object",
      "required": ["outputs"],
      "additionalProperties": false,
      "properties": {
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "content"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "content": { "type": "string" }
            }
          }
        },
        "config": {
          "type": "object",
          "required": ["claims", "values"],
          "additionalProperties": false,
          "properties": {
            "claims": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$" },
              "uniqueItems": true
            },
            "values": { "$ref": "#/$defs/initConfigObject" }
          }
        }
      }
    }
  }
}
