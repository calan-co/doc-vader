{
  "version": "1.0.0",
  "roots": {
    "backlog": "backlog",
    "active": "backlog",
    "archive": "backlog/archive",
    "records": "backlog/records",
    "audit": "backlog/audit"
  },
  "task": {
    "claimStorePath": ".doc-vader/runtime/task-claims"
  },
  "automation": {
    "autoCloseOnMerge": true,
    "autoEvidenceFromWorkflowRuns": true,
    "preserveCommitMap": true,
    "workItemMatchPatterns": [
      "work-item:",
      "wi-"
    ],
    "pullRequestPath": "links.pull_requests",
    "requiredCandidateFields": [
      "actual",
      {
        "field": "status",
        "values": [
          "completed"
        ]
      }
    ],
    "prePushValidation": {
      "schemas": {
        "baseline": "schemas/work-management/frontmatter/work-item.json",
        "changed": "schemas/work-management/frontmatter/work-item.json",
        "archive": "schemas/work-management/frontmatter/work-item.json"
      },
      "severity": {
        "baseline": "error",
        "changed": "error",
        "archive": "none",
        "checklist": "error"
      }
    }
  }
}
