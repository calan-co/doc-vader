FROM node:22-bookworm

# Install system dependencies
RUN apt-get update && apt-get install -y \
  git \
  curl \
  jq \
  && rm -rf /var/lib/apt/lists/*

# Custom issue tracker: doc-vader work-management over the mounted repository.
# No external tracker CLI install is required.

# Match the repository package manager for sandbox dependency refresh hooks.
RUN npm install -g pnpm@8.15.0

# Build-args for UID/GID alignment: sandcastle docker build-image
# defaults these to the host user's UID/GID so image-built files
# and bind-mounted files share an owner without runtime chown.
ARG AGENT_UID=1000
ARG AGENT_GID=1000

# Rename the base image's "node" user to "agent" and align UID/GID.
RUN groupmod -o -g $AGENT_GID node && usermod -o -u $AGENT_UID -g $AGENT_GID -d /home/agent -m -l agent node

# Install Codex CLI (run as root before USER agent)
RUN npm install -g @openai/codex

# Prewarm a Linux-native pnpm store during image build to reduce cold-start
# dependency fetch time for recurring sandbox runs.
RUN mkdir -p /home/agent/.cache/pnpm/store
WORKDIR /tmp/prewarm
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch --frozen-lockfile --prefer-offline --store-dir /home/agent/.cache/pnpm/store
RUN chown -R ${AGENT_UID}:${AGENT_GID} /home/agent/.cache /tmp/prewarm

USER ${AGENT_UID}:${AGENT_GID}

WORKDIR /home/agent

# In worktree sandbox mode, Sandcastle bind-mounts the git worktree at /home/agent/workspace
# and overrides the working directory to /home/agent/workspace at container start.
# Structure your Dockerfile so that /home/agent/workspace can serve as the project root.
ENTRYPOINT ["sleep", "infinity"]
