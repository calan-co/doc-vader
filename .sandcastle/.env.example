# Auth mode: defaults to `cli` (uses local `codex login` session).
# Set `api-key` only when you explicitly want key-based auth.
# SANDCASTLE_AUTH_MODE=cli

# Sandbox provider is required and must be explicit.
# Supported values: podman | docker | no-sandbox
SANDCASTLE_SANDBOX_PROVIDER=podman

# Podman userns mode.
# On macOS, `false` avoids keep-id mapping issues in some podman/crun setups.
# SANDCASTLE_PODMAN_USERNS=false

# Idle timeout in seconds (agent output silence timeout).
# SANDCASTLE_IDLE_TIMEOUT_SECONDS=1200

# Maximum plan->execute->merge cycles before exit.
# SANDCASTLE_MAX_ITERATIONS=10

# Do not copy host node_modules into Linux sandboxes unless you know binaries
# are compatible. Keep this false for macOS host + Linux sandbox workflows.
# SANDCASTLE_COPY_NODE_MODULES=false

# Persistent Linux pnpm store cache mount for fast recurring sandbox startup.
# Keep this path separate from host project node_modules.
# SANDCASTLE_HOST_PNPM_STORE_PATH=~/.cache/doc-vader/sandcastle/pnpm-store-linux-arm64
# SANDCASTLE_HOST_NODE_MODULES_PATH=~/.cache/doc-vader/sandcastle/node_modules-linux-arm64
# SANDCASTLE_PNPM_STORE_PATH=/home/agent/.cache/pnpm/store
# Startup behavior is offline-first install from this store, with fetch fallback.

# API-key mode (optional)
# CODEX_API_KEY=

# Also supported by Codex CLI
# OPENAI_API_KEY=

# Legacy fallback used by this template's preflight
# OPENAI_KEY=

# Issue tracker: doc-vader work-management uses the mounted repository and
# the logged-in local CLI environment. No tracker token is required.
