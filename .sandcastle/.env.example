# Auth mode: defaults to `cli` (uses local `codex login` session).
# Set `api-key` only when you explicitly want key-based auth.
# SANDCASTLE_AUTH_MODE=cli

# API-key mode (optional)
# CODEX_API_KEY=

# Also supported by Codex CLI
# OPENAI_API_KEY=

# Legacy fallback used by this template's preflight
# OPENAI_KEY=

# Issue tracker: doc-vader work-management uses the mounted repository and
# the logged-in local CLI environment. No tracker token is required.
